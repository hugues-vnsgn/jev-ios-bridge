      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "Contact photo for Tessa Vale"
        }
      }
    },
    {
      "id": "verify",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "role": "application",
            "label": "Contacts"
          },
          {
            "role": "text-field",
            "value": "Search"
          }
        ]
      },
      "assertions": [
        {
          "id": "claim",
          "claim": "The Contacts list is visible."
        }
      ]
    }
  ]
