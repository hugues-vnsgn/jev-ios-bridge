{
  "app": {
    "bundleId": "com.apple.MobileAddressBook"
  },
  "device": {
    "udid": "0E42FDE2-5E09-42D3-9876-9EF0037FCBE7"
  },
  "preconditions": [
    "Contacts Search is in front with one active Search text field."
  ],
  "values": {
    "query": "Nina Calder"
  },
  "steps": [
    {
      "id": "searchNina",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "application",
            "label": "Contacts"
          },
          {
            "role": "other",
            "label": "Search results"
          },
          {
            "role": "text-field"
          }
        ]
      },
      "action": {
        "kind": "replaceText",
        "selector": {
          "role": "text-field"
        },
        "valueKey": "query"
      }
    },
    {
      "id": "settleResults",
      "kind": "wait",
      "guard": {
        "present": [
          {
            "role": "text-field",
            "value": "Nina Calder"
          }
        ]
      },
      "until": {
        "present": [
          {
            "role": "text",
            "label": "No Results for “Nina Calder”"
          }
        ]
      },
      "timeoutMs": 10000
    },
    {
      "id": "verify",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "role": "text-field",
            "value": "Nina Calder"
          },
          {
            "role": "other",
            "label": "Search results"
          }
        ]
      },
      "assertions": [
        {
          "id": "claim",
          "claim": "A Nina Calder contact card is open."
        }
      ]
    }
  ]
}
