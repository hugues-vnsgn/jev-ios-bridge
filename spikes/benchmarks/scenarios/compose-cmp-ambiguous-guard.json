{
  "version": 1,
  "app": {
    "bundleId": "org.example.project.cmp"
  },
  "preconditions": [
    "Build ~/Codes/cmp as it is (Compose Multiplatform 1.11.1) and install it on the dedicated simulator.",
    "The app opens on its modal-perf tab, whose harness runs about 25 s after launch; the first step waits it out."
  ],
  "values": {},
  "steps": [
    {
      "id": "harnessIdle",
      "kind": "wait",
      "guard": {
        "present": [
          {
            "role": "application",
            "label": "cmp"
          }
        ]
      },
      "until": {
        "present": [
          {
            "role": "text",
            "label": "done (or idle) — see logcat tag MODALPERF"
          }
        ],
        "absent": [
          {
            "role": "text",
            "label": "idle"
          },
          {
            "role": "text",
            "label": "running…"
          }
        ]
      },
      "timeoutMs": 60000
    },
    {
      "id": "openModalTab",
      "kind": "action",
      "guard": {
        "present": [
          {
            "identifier": "tabFullScreenModal"
          },
          {
            "identifier": "runPerf"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "identifier": "tabFullScreenModal"
        }
      }
    },
    {
      "id": "openOuter",
      "kind": "action",
      "guard": {
        "present": [
          {
            "identifier": "openModal"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "identifier": "openModal"
        }
      }
    },
    {
      "id": "labelOnlyGuard",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "label": "Close outer"
          }
        ]
      },
      "assertions": [
        {
          "id": "close",
          "claim": "A Close outer button is visible."
        }
      ]
    }
  ]
}
