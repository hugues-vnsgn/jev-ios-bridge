{
  "version": 1,
  "platform": "android",
  "app": {
    "package": "com.android.settings"
  },
  "preconditions": [
    "Written for Android 12 (jev-actions-api31), whose Settings names the search bar \"Search settings\" and the display row \"Display\"; check 4 runs it there only.",
    "Settings on a stock emulator with Dark theme off. Nothing is installed; the bridge restarts Settings.",
    "This emulator's Settings search returns no results, so the search box is the typing check: the leaveSearch guard needs the field to show exactly the typed value.",
    "The non-English typing gate: the query is Vietnamese, typed through the clipboard, and checked by the leaveSearch guard."
  ],
  "values": {
    "query": "Tiếng Việt"
  },
  "steps": [
    {
      "id": "openSearch",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "button",
            "identifier": "com.android.settings:id/search_action_bar",
            "label": "Search settings"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "identifier": "com.android.settings:id/search_action_bar"
        }
      }
    },
    {
      "id": "typeQuery",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "text-field",
            "identifier": "com.google.android.settings.intelligence:id/open_search_view_edit_text"
          }
        ]
      },
      "action": {
        "kind": "replaceText",
        "selector": {
          "role": "text-field",
          "identifier": "com.google.android.settings.intelligence:id/open_search_view_edit_text"
        },
        "valueKey": "query"
      }
    },
    {
      "id": "leaveSearch",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "text-field",
            "identifier": "com.google.android.settings.intelligence:id/open_search_view_edit_text",
            "value": "Tiếng Việt"
          },
          {
            "role": "button",
            "label": "Back"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "Back"
        }
      }
    },
    {
      "id": "openDisplay",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "button",
            "identifier": "com.android.settings:id/search_action_bar",
            "label": "Search settings"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "Display"
        }
      }
    },
    {
      "id": "darkTheme",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "role": "switch",
            "label": "Dark theme"
          }
        ]
      },
      "assertions": [
        {
          "id": "off",
          "claim": "The Dark theme switch is off."
        }
      ]
    }
  ]
}
