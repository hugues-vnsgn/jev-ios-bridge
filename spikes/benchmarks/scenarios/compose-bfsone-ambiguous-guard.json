{
  "version": 1,
  "app": {
    "bundleId": "com.beelogistics.BFSOne",
    "launchArgs": [
      "-of-evidence-gallery"
    ]
  },
  "preconditions": [
    "Build BFSOne_Mobile_App from the pinned commit carrying the debug-only -of-evidence-gallery launch argument (Compose Multiplatform 1.9.0) and install it on the dedicated simulator.",
    "The argument opens the Design System gallery offline: no login and no request to api.beelogistics.com. Never log in or submit anything in this app."
  ],
  "values": {},
  "steps": [
    {
      "id": "scroll1",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "application",
            "label": "BFS One"
          }
        ]
      },
      "action": {
        "kind": "swipe",
        "selector": {
          "role": "scroll-view"
        },
        "direction": "up"
      }
    },
    {
      "id": "scroll2",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "application",
            "label": "BFS One"
          }
        ]
      },
      "action": {
        "kind": "swipe",
        "selector": {
          "role": "scroll-view"
        },
        "direction": "up"
      }
    },
    {
      "id": "labelOnlyGuard",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "label": "Disabled"
          }
        ]
      },
      "assertions": [
        {
          "id": "disabled",
          "claim": "A Disabled text field is visible."
        }
      ]
    }
  ]
}
