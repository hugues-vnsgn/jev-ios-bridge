{
  "version": 1,
  "platform": "android",
  "app": {
    "package": "org.example.project"
  },
  "preconditions": [
    "Build ~/Codes/cmp as it is (./gradlew :androidApp:assembleDebug) and install it with adb install -r on the emulator.",
    "The app opens on its modal-perf tab. The captures show no identifiers (no testTagsAsResourceId), so selectors use role plus label.",
    "The only empty field (de-DE, built-in keypad) takes input only from cmp's own keypad, not the system keyboard, so typing into an empty placeholder field is covered by android-settings-search's empty search field instead."
  ],
  "values": {
    "amount": "3500000"
  },
  "steps": [
    {
      "id": "openNumberTab",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "button",
            "label": "number-input"
          },
          {
            "role": "button",
            "label": "modal-perf"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "number-input"
        }
      }
    },
    {
      "id": "replaceDong",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "vi-VN, sig=0 (đồng)"
          },
          {
            "role": "text-field",
            "value": "2.500.000"
          }
        ]
      },
      "action": {
        "kind": "replaceText",
        "selector": {
          "role": "text-field",
          "value": "2.500.000"
        },
        "valueKey": "amount"
      }
    },
    {
      "id": "formatted",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "vi-VN, sig=0 (đồng)"
          },
          {
            "role": "text",
            "label": "de-DE, sig=3"
          }
        ]
      },
      "assertions": [
        {
          "id": "dong",
          "claim": "The number field under vi-VN, sig=0 (đồng) shows 3.500.000."
        }
      ]
    }
  ]
}
