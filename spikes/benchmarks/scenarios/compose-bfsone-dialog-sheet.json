    {
      "id": "openDialog",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "§02 OFDialog / OFBottomSheet / OFEmptyState"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "Confirm 2 nút"
        }
      }
    },
    {
      "id": "dialogOpen",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "Delete Request"
          }
        ],
        "absent": [
          {
            "role": "text",
            "label": "§02 OFDialog / OFBottomSheet / OFEmptyState"
          }
        ]
      },
      "assertions": [
        {
          "id": "question",
          "claim": "A Delete Request dialog asks: Are you sure you want to delete this request?"
        }
      ]
    },
    {
      "id": "closeDialog",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "Delete Request"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "CLOSE"
        }
      }
    },
    {
      "id": "openSheet",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "§02 OFDialog / OFBottomSheet / OFEmptyState"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "Bottom Sheet"
        }
      }
    },
    {
      "id": "sheetOpen",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "OFBottomSheet"
          }
        ],
        "absent": [
          {
            "role": "text",
            "label": "§02 OFDialog / OFBottomSheet / OFEmptyState"
          }
        ]
      },
      "assertions": [
        {
          "id": "title",
          "claim": "A bottom sheet titled OFBottomSheet is open."
        }
      ]
    },
    {
      "id": "closeSheet",
      "kind": "action",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "OFBottomSheet"
          }
        ]
      },
      "action": {
        "kind": "tap",
        "selector": {
          "role": "button",
          "label": "Close"
        }
      }
    },
    {
      "id": "backToGallery",
      "kind": "checkpoint",
      "guard": {
        "present": [
          {
            "role": "text",
            "label": "§02 OFDialog / OFBottomSheet / OFEmptyState"
          }
        ],
        "absent": [
          {
            "role": "text",
            "label": "OFBottomSheet"
          }
        ]
      },
      "assertions": [
        {
          "id": "buttons",
          "claim": "A Bottom Sheet button is visible."
        }
      ]
    }
