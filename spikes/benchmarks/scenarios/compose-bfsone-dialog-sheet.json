    "bundleId": "com.beelogistics.BFSOne",
    "launchArgs": [
      "-of-evidence-gallery"
    ]
  },
  "preconditions": [
    "Build BFSOne_Mobile_App from the pinned commit carrying the debug-only -of-evidence-gallery launch argument (Compose Multiplatform 1.9.0) and install it on the dedicated simulator.",
    "The argument opens the Design System gallery offline: no login and no request to api.beelogistics.com. Never log in or submit anything in this app."
  ],
