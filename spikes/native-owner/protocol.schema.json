{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native owner study record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "sequence", "kind", "operation", "outcome", "elapsedMs", "inputCalls", "details"],
  "properties": {
    "schema": {"const": "jev.native-owner/1"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["started", "observation", "finished"]},
    "operation": {"enum": ["metadata", "point", "validity", "snapshot", "parent", "fixture-recreation"]},
    "outcome": {"enum": ["observed", "unavailable", "failed"]},
    "elapsedMs": {"type": "number", "minimum": 0},
    "inputCalls": {"const": 0},
    "details": {"type": "object"}
  },
  "$comment": "Stream invariants, details and byte limits are specified in .scratch/native-owner-implementation/spec.md. Labels correlate local retained objects only; records never certify native identity, complete ancestry, lifetime scope or settlement."
}
