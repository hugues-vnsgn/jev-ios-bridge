{
  "name": "jev-ios-bridge",
  "version": "1.0.0",
  "description": "Evidence-backed iOS scenario verification with Jev and MobileBuildMCP",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jev-ios-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "docs/usage.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "feasibility": "tsx spikes/feasibility/cli.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hugues-vnsgn/jev-ios-bridge.git"
  },
  "homepage": "https://github.com/hugues-vnsgn/jev-ios-bridge"
}
