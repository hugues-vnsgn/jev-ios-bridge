{
  "app": { "bundleId": "dev.jevbridge.diagnostic" },
  "preconditions": [
    "Diagnostic App starts with Selected: None."
  ],
  "values": {},
  "steps": [
    {
      "id": "addApple",
      "kind": "action",
      "guard": {
        "present": [
          { "role": "text", "identifier": "selection.summary", "label": "Selected: None" },
          { "role": "button", "identifier": "choose.apple", "label": "Add Apple ($2)" },
          { "role": "button", "identifier": "choose.bread", "label": "Add Bread ($3)" }
        ]
      },
      "action": { "kind": "tap", "selector": { "role": "button", "identifier": "choose.apple" } }
    },
    {
      "id": "addBread",
      "kind": "action",
      "guard": {
        "present": [
          { "role": "text", "identifier": "selection.summary", "label": "Selected: Apple" },
          { "role": "button", "identifier": "choose.bread", "label": "Add Bread ($3)" }
        ]
      },
      "action": { "kind": "tap", "selector": { "role": "button", "identifier": "choose.bread" } }
    },
    {
      "id": "finishOrder",
      "kind": "action",
      "guard": {
        "present": [
          { "role": "text", "identifier": "selection.summary", "label": "Selected: Apple, Bread" },
          { "role": "button", "identifier": "order.complete" }
        ]
      },
      "action": { "kind": "tap", "selector": { "role": "button", "identifier": "order.complete" } }
    },
    {
      "id": "verify",
      "kind": "checkpoint",
      "guard": {
        "present": [
          { "role": "text", "identifier": "confirmation.title", "label": "Order complete" },
          { "role": "text", "label": "Apple: $2" },
          { "role": "text", "label": "Bread: $3" }
        ]
      },
      "assertions": [
        { "id": "total", "claim": "The Order complete confirmation shows Total: $5." }
      ]
    }
  ]
}
