 const productionProcesses = new WeakSet<SourceProcess>();
 export const isProductionSourceProcess = (process: SourceProcess): boolean => productionProcesses.has(process);
+/** Compose allocation tracking without exposing installed metadata expectations. */
+export function trackAllocationSourceProcess(process: SourceProcess,
+  track: (operation: string, invoke: () => ReturnType<SourceProcess>) => ReturnType<SourceProcess>): SourceProcess {
+  const installed = productionInvokers.get(process);
+  const invoke: InstalledProcess = (executable, args, options, expected) => track(executable, () => {
+    options.signal.throwIfAborted();
+    return installed ? installed(executable, args, options, expected) : process(executable, args, options);
+  });
+  const tracked: SourceProcess = (executable, args, options) => invoke(executable, args, options);
+  if (installed) productionInvokers.set(tracked, invoke);
+  if (isProductionSourceProcess(process)) productionProcesses.add(tracked);
+  return tracked;
+}
