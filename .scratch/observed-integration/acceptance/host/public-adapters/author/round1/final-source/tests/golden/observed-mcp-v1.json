{
  "version": 1,
  "tools": [
    {
      "name": "cancel_observed_action",
      "description": "Explicitly cancel the exact observed action and wait at most 5000ms for local finalization. Cancellation cannot certify native release; unknown work stays unavailable. Terminal cancellation retrieves.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "actionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          }
        },
        "required": [
          "actionId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "cancel_observed_allocation",
      "description": "Cancel active preparation with bounded local finalization, or retire ready unused stock. Executing ALLOCATION_BUSY directs cancel_observed_action; no device cleanup, reuse or owner takeover.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "allocationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "allocationId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_observed_action",
      "description": "Read one consistent authoritative observed action snapshot and full local evidence pointers. waitMs is 0–45000; aborting this wait stops only the wait. No recovery or replay.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "actionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "waitMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 45000
          }
        },
        "required": [
          "actionId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_observed_allocation",
      "description": "Read persisted allocation authority, evidence and retention. waitMs is 0–45000; aborting this wait stops only the wait. Historical readOnly/historicalOutcome never grant preparation or input permission.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "allocationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "waitMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 45000
          }
        },
        "required": [
          "allocationId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "prepare_observed_allocation",
      "description": "Prepare one dedicated simulator for the declared action identity, retaining it after use or uncertainty. Requires explicit compatible source and unmodified app artifact. No automatic replacement or replay; preparation waits within its bounded budgets.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "actionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "create"
                  },
                  "deviceTypeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "runtimeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind",
                  "deviceTypeId",
                  "runtimeId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "supplied"
                  },
                  "inventoryId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind",
                  "inventoryId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "app": {
            "type": "object",
            "properties": {
              "artifactPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "bundleId": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
              },
              "build": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "origin": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "id",
                  "origin"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "artifactPath",
              "bundleId",
              "build"
            ],
            "additionalProperties": false
          },
          "timeoutMs": {
            "default": 360000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 900000
          }
        },
        "required": [
          "version",
          "actionId",
          "source",
          "app"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "retire_observed_allocation",
      "description": "Change ready allocation retention metadata only; never stop, delete or reuse a device. Active preparing ALLOCATION_BUSY directs cancel_observed_allocation; executing directs cancel_observed_action. Terminal and historical retirement retrieve.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "allocationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "allocationId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start_observed_action",
      "description": "Start one observed tap on a prepared dedicated allocation. Returns visible predicate evidence, never a Jev verdict or native receipt. Retry the exact same identity/request only to retrieve; poll get_observed_action. Transport cancellation does not cancel an admitted action.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "actionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "allocationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "app": {
            "type": "object",
            "properties": {
              "bundleId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
              }
            },
            "required": [
              "bundleId"
            ],
            "additionalProperties": false
          },
          "action": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "tap"
              },
              "selector": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "application",
                      "window",
                      "button",
                      "keyboard-key",
                      "text-field",
                      "menu",
                      "text",
                      "image",
                      "switch",
                      "slider",
                      "cell",
                      "scroll-view",
                      "list",
                      "tab",
                      "other"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "selector"
            ],
            "additionalProperties": false
          },
          "before": {
            "type": "object",
            "properties": {
              "present": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifier": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "application",
                        "window",
                        "button",
                        "keyboard-key",
                        "text-field",
                        "menu",
                        "text",
                        "image",
                        "switch",
                        "slider",
                        "cell",
                        "scroll-view",
                        "list",
                        "tab",
                        "other"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "additionalProperties": false
                }
              },
              "absent": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifier": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "application",
                        "window",
                        "button",
                        "keyboard-key",
                        "text-field",
                        "menu",
                        "text",
                        "image",
                        "switch",
                        "slider",
                        "cell",
                        "scroll-view",
                        "list",
                        "tab",
                        "other"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "present"
            ],
            "additionalProperties": false
          },
          "after": {
            "type": "object",
            "properties": {
              "present": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifier": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "application",
                        "window",
                        "button",
                        "keyboard-key",
                        "text-field",
                        "menu",
                        "text",
                        "image",
                        "switch",
                        "slider",
                        "cell",
                        "scroll-view",
                        "list",
                        "tab",
                        "other"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "additionalProperties": false
                }
              },
              "absent": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifier": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "application",
                        "window",
                        "button",
                        "keyboard-key",
                        "text-field",
                        "menu",
                        "text",
                        "image",
                        "switch",
                        "slider",
                        "cell",
                        "scroll-view",
                        "list",
                        "tab",
                        "other"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "present"
            ],
            "additionalProperties": false
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          }
        },
        "required": [
          "version",
          "actionId",
          "allocationId",
          "app",
          "action",
          "before",
          "after",
          "timeoutMs"
        ],
        "additionalProperties": false
      }
    }
  ]
}
